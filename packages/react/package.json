{
  "name": "@casewave/react",
  "version": "0.1.0",
  "description": "React renderer for CaseWave graph engine",
  "author": "mrkwxopya",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@casewave/core": "0.1.0"
  },
  "dependencies": {
    "@casewave/core": "0.1.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react --external react-dom",
    "typecheck": "tsc --noEmit",
    "clean": "node ./scripts/clean.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mrkwxopya/casewave.git",
    "directory": "packages/react"
  },
  "keywords": [
    "casewave",
    "react",
    "graph",
    "node-link",
    "diagram",
    "knowledge-graph",
    "typescript"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false
}