{
    "name": "@casewavejs/themes",
    "version": "0.3.0",
    "description": "51 ready-to-use theme presets and registry utilities for CaseWave.",
    "author": "mrkwxopya",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "dependencies": {
        "@casewavejs/core": "^0.3.0",
        "@casewavejs/react": "^0.3.0"
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts",
        "typecheck": "tsc --noEmit",
        "clean": "node ./scripts/clean.cjs"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/mrkwxopya/casewavejs.git"
    },
    "keywords": [
        "casewave",
        "themes",
        "react",
        "graph",
        "node-editor",
        "diagram",
        "investigation-board",
        "knowledge-graph",
        "typescript"
    ],
    "files": [
        "dist",
        "README.md"
    ],
    "sideEffects": false,
    "homepage": "https://mrkwxopya.github.io/casewavejs/",
    "bugs": {
        "url": "https://github.com/mrkwxopya/casewavejs/issues"
    },
    "publishConfig": {
        "access": "public"
    }
}
